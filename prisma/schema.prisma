generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model about_content {
  id         Int     @id @default(autoincrement())
  content    String? @db.Text
  content_bn String? @db.LongText
  image      String? @db.VarChar(255)
}

model admin_login {
  id        Int     @id @default(autoincrement())
  name      String? @db.VarChar(255)
  email     String? @db.VarChar(255)
  password  String? @db.VarChar(225)
  user_type String? @default("Admin") @db.VarChar(225)
  image     String? @db.VarChar(225)
}

model blogs {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(255)
  name_bn        String?  @db.VarChar(255)
  category       String?  @db.VarChar(255)
  category_bn    String?  @db.VarChar(255)
  description    String?  @db.Text
  description_bn String?  @db.Text
  author_name    String?  @db.VarChar(255)
  author_name_bn String?  @db.VarChar(255)
  image          String?  @db.VarChar(255)
  created_at     DateTime @default(now()) @db.Timestamp(0)
}

model contact_details {
  id       Int     @id @default(1)
  location String? @db.Text
  phone    String? @db.VarChar(255)
  email    String? @db.VarChar(255)
}

model events {
  id            Int      @id @default(autoincrement())
  event_name    String   @db.VarChar(255)
  event_name_bn String?  @db.VarChar(255)
  event_date    DateTime @db.DateTime(0)
  venue         String   @db.VarChar(255)
  venue_bn      String?  @db.VarChar(255)
  details       String?  @db.Text
  details_bn    String?  @db.Text
  image         String?  @db.VarChar(255)
  ticket_link   String?  @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
}

model gallery {
  id         Int      @id @default(autoincrement())
  title      String?  @db.VarChar(255)
  image      String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model hero_images {
  id         Int      @id @default(autoincrement())
  image      String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model locations {
  id          Int    @id @default(autoincrement())
  branch_name String @db.VarChar(255)
  address     String @db.Text
}

model members {
  id            Int     @id @default(autoincrement())
  name          String? @db.VarChar(255)
  designation   String? @db.VarChar(1000)
  email         String? @db.VarChar(255)
  linkedln_link String? @db.VarChar(255)
  facebook_link String? @db.VarChar(255)
  image         String? @db.VarChar(255)
}

model messages {
  id      Int     @id @default(autoincrement())
  name    String? @db.VarChar(255)
  email   String? @db.VarChar(255)
  phone   String? @db.VarChar(255)
  message String? @db.Text
}

model portfolios {
  id          Int     @id @default(autoincrement())
  name        String? @db.VarChar(255)
  category    String? @db.VarChar(255)
  description String? @db.Text
  image       String? @db.VarChar(255)
}

model services {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(255)
  title_bn       String?  @db.VarChar(255)
  description    String   @db.Text
  description_bn String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamp(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model testimonials {
  id         Int      @id @default(autoincrement())
  t_name     String   @db.VarChar(150)
  t_des      String   @db.Text
  t_review   String?  @default("5.0") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(0)
}
